rules_version = '2';

// ============================================================================
// Lexathon / Wordcade — Firestore Security Rules
//
// DEPLOY: firebase deploy --only firestore:rules
//         (or paste into Firebase Console -> Firestore Database -> Rules ->
//         Publish). Free on the Spark plan — no billing required.
//
// ARCHITECTURE (see functions/index.js): every field with real value —
// wallet, careerBank, mmr, win/loss/tie records, career+daily stat
// counters, inventory, username, challenge-claimed lists, match payouts —
// is written ONLY by a Cloud Function via the Admin SDK, which bypasses
// these rules entirely. These rules are the backstop: even if a client
// tried to call the Firestore SDK directly instead of going through a
// Cloud Function, it physically cannot write any of those fields.
//
// The client's only remaining direct writes to its own profile are its
// cosmetic loadout (`equipped` — no monetary value) and creating the
// initial doc on signup (locked to the same zeroed defaults every new
// player gets). It may also create `runs` and `matches` documents (bounded
// here, then validated/acted on by Cloud Function triggers) and update
// `matches` documents it's a participant in (live gameplay fields only —
// payout fields are denied).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // 1v1 duel matches never set a `mode` field at all (only FFA matches
    // do) — resource.data.mode would THROW on a duel match if read with
    // plain dot notation (Firestore rules error out on a genuinely missing
    // map key, they don't just return null), which would deny every 1v1
    // match update outright. .get(key, default) is the safe way to read a
    // field that may not exist.
    function matchMode(m) { return m.get('mode', 'duel'); }

    match /users/{userId} {
      // Public profile info (username, cosmetics, mmr, careerBank) is read
      // for the leaderboard, live feed, and rank lookups.
      allow read: if isSignedIn();

      // New accounts must start at the same defaults the app gives every
      // player — no "create my doc pre-loaded with a million points".
      allow create: if isOwner(userId)
        && request.resource.data.wallet == 0
        && request.resource.data.careerBank == 0
        && request.resource.data.mmr == 1000
        && request.resource.data.handleChanges == 0
        && request.resource.data.totalWordsGuessed == 0
        && request.resource.data.wordsPlayed == 0
        && request.resource.data.guess1 == 0 && request.resource.data.guess2 == 0
        && request.resource.data.guess3 == 0 && request.resource.data.guess4 == 0
        && request.resource.data.guess5 == 0 && request.resource.data.fails == 0
        && request.resource.data.kobeCount == 0
        && request.resource.data.clashWins == 0 && request.resource.data.clashLosses == 0
        && request.resource.data.clashTies == 0
        // These four directly gate one-time challenge rewards (up to 75k
        // pts) — without forcing them to 0/null here, a throwaway account
        // could self-seed a fake streak and claim rewards it never earned.
        && request.resource.data.loginStreak == 0 && request.resource.data.bestLoginStreak == 0
        && request.resource.data.lastLoginDate == null
        && request.resource.data.currentClashWinStreak == 0 && request.resource.data.bestClashWinStreak == 0
        && request.resource.data.bestNoMissStreak == 0
        && request.resource.data.inventory == ["title_none", "skin_default", "banner_default", "effect_none"]
        && request.resource.data.claimedCareer == []
        && request.resource.data.dailyStats.played == 0
        && request.resource.data.dailyStats.guessed == 0
        && request.resource.data.dailyStats.claimed == [];

      // The ONLY field the client may ever update directly on its own
      // profile is its cosmetic loadout. Wallet, careerBank, mmr, win/loss
      // records, stat counters, inventory, username, claimed lists — all of
      // it goes through a Cloud Function instead.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['equipped']);

      allow delete: if false;
    }

    match /runs/{runId} {
      allow read: if isSignedIn();

      // The client reports what happened in a run; the onRunCreated Cloud
      // Function is what turns this into wallet/stat changes on the user
      // doc, after these bounds are enforced. Bounds are deliberately
      // generous (they exist to block "set score to a billion", not to
      // referee gameplay balance).
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 1000000
        && request.resource.data.lostScore is number && request.resource.data.lostScore >= 0 && request.resource.data.lostScore <= 1000000
        && request.resource.data.wordsGuessed is number && request.resource.data.wordsGuessed >= 0 && request.resource.data.wordsGuessed <= 5000
        && request.resource.data.wordsPlayed is number && request.resource.data.wordsPlayed >= 0 && request.resource.data.wordsPlayed <= 5000
        && request.resource.data.guess1 is number && request.resource.data.guess1 >= 0 && request.resource.data.guess1 <= 5000
        && request.resource.data.guess2 is number && request.resource.data.guess2 >= 0 && request.resource.data.guess2 <= 5000
        && request.resource.data.guess3 is number && request.resource.data.guess3 >= 0 && request.resource.data.guess3 <= 5000
        && request.resource.data.guess4 is number && request.resource.data.guess4 >= 0 && request.resource.data.guess4 <= 5000
        && request.resource.data.guess5 is number && request.resource.data.guess5 >= 0 && request.resource.data.guess5 <= 5000
        && request.resource.data.fails is number && request.resource.data.fails >= 0 && request.resource.data.fails <= 5000
        && request.resource.data.kobeCount is number && request.resource.data.kobeCount >= 0 && request.resource.data.kobeCount <= 5000
        && request.resource.data.bestStreak is number && request.resource.data.bestStreak >= 0 && request.resource.data.bestStreak <= 5000
        && request.resource.data.timestamp == request.time;

      // payoutApplied is added afterwards by the Cloud Function (Admin SDK,
      // bypasses rules) — the client can never edit a run once created.
      allow update, delete: if false;
    }

    match /matches/{matchId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;

      // Either participant can update live gameplay fields (scores, mini-
      // boards, chat, endTime, and status/winner to signal "this match is
      // over"), but neither may touch the payout fields — those are
      // Cloud-Function-only (see onMatchFinished). 1v1 duels only —
      // mode:'ffa' matches are handled by the block below instead.
      allow update: if isSignedIn() && matchMode(resource.data) != 'ffa'
        && (resource.data.hostUid == request.auth.uid
            || resource.data.guestUid == request.auth.uid
            || (resource.data.guestUid == null && request.resource.data.guestUid == request.auth.uid))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hostChange', 'guestChange', 'payoutApplied']);

      // Clash: Free-For-All (2-4 players, see functions/index.js). Unlike
      // the 1v1 rule above, joining/starting/finishing a match ALL go
      // through callables (joinFfaMatch/startFfaMatch/finishFfaMatch) —
      // there's a real race in claiming one of a fixed number of open
      // slots that a plain client updateDoc can't safely resolve, the way
      // 1v1's single guest slot gets away with. So a client here may only
      // ever touch its own live gameplay fields (pNScore/pNBoard/
      // pNWordIndex) and chat — every identity, roster, timing, and payout
      // field is Admin-SDK-only.
      allow update: if isSignedIn() && matchMode(resource.data) == 'ffa'
        && (request.auth.uid == resource.data.p0Uid || request.auth.uid == resource.data.p1Uid
            || request.auth.uid == resource.data.p2Uid || request.auth.uid == resource.data.p3Uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'mode', 'hostUid', 'isPublic', 'status', 'maxPlayers', 'playerCount',
             'words', 'endTime', 'lobbyDeadline', 'winners', 'changes', 'payoutApplied',
             'p0Uid', 'p1Uid', 'p2Uid', 'p3Uid',
             'p0Name', 'p1Name', 'p2Name', 'p3Name',
             'p0Equipped', 'p1Equipped', 'p2Equipped', 'p3Equipped',
             'p0Mmr', 'p1Mmr', 'p2Mmr', 'p3Mmr'
           ]);

      // A 1v1 host may delete their match at any time (mirrors the client's
      // existing leaveVersusMatch behavior). An FFA host may only delete
      // theirs while it's still a lobby — once it's 'playing', up to 3
      // other real players are mid-race in it; deleting the doc would wipe
      // the match for all of them and skip payout entirely, instead of the
      // host's own slot simply going stale like any other abandoned player.
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid
        && (matchMode(resource.data) != 'ffa' || resource.data.status == 'waiting');
    }

    // Daily Gauntlet's target words — NEVER readable by any client. The
    // client only ever learns them one guess's color feedback at a time via
    // the guessDailyWord Cloud Function; a readable rule here would let
    // anyone open devtools and read the day's answers before playing.
    match /dailyPuzzles/{date} {
      allow read, write: if false;
    }

    // A player's own progress through today's (or a past) gauntlet — safe
    // to let them read directly (past guesses + color feedback + score,
    // never the unsolved target words), but every write goes through
    // startDailyGauntlet/guessDailyWord (Admin SDK), never the client SDK.
    match /dailyAttempts/{userId}/days/{date} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Clash sudden-death's secret word + each side's graded guess for the
    // current round — same reasoning as dailyPuzzles: never client-readable,
    // or a devtools-savvy player could see the word (or their opponent's
    // still-pending guess) before the round resolves. Public, non-spoiling
    // state (round number, deadline, who's submitted, the eventual result)
    // lives on the match doc instead, written by the same Cloud Functions.
    match /matchSecrets/{matchId} {
      allow read, write: if false;
    }
  }
}
