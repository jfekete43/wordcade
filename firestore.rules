rules_version = '2';

// ============================================================================
// Lexathon / Wordcade — Firestore Security Rules
//
// DEPLOY: firebase deploy --only firestore:rules
//         (or paste into Firebase Console -> Firestore Database -> Rules ->
//         Publish). Free on the Spark plan — no billing required.
//
// ARCHITECTURE (see functions/index.js): every field with real value —
// wallet, careerBank, mmr, win/loss/tie records, career+daily stat
// counters, inventory, username, challenge-claimed lists, match payouts —
// is written ONLY by a Cloud Function via the Admin SDK, which bypasses
// these rules entirely. These rules are the backstop: even if a client
// tried to call the Firestore SDK directly instead of going through a
// Cloud Function, it physically cannot write any of those fields.
//
// The client's only remaining direct writes to its own profile are its
// cosmetic loadout (`equipped` — no monetary value) and creating the
// initial doc on signup (locked to the same zeroed defaults every new
// player gets). It may also create `runs` and `matches` documents (bounded
// here, then validated/acted on by Cloud Function triggers) and update
// `matches` documents it's a participant in (live gameplay fields only —
// payout fields are denied).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // 1v1 duel matches never set a `mode` field at all (only FFA matches
    // do) — resource.data.mode would THROW on a duel match if read with
    // plain dot notation (Firestore rules error out on a genuinely missing
    // map key, they don't just return null), which would deny every 1v1
    // match update outright. .get(key, default) is the safe way to read a
    // field that may not exist.
    function matchMode(m) { return m.get('mode', 'duel'); }

    // ---- MATCH CHAT ---------------------------------------------------------
    // Chat used to be an array of HTML STRINGS that the client built and these
    // rules never looked at. escapeHtml() ran in the sender's own browser,
    // which protects nobody — the attacker is the sender. A participant could
    // updateDoc `<img src=x onerror=...>` into the array and both renderers
    // dropped it into innerHTML, so it executed on the opponent's page at the
    // lexathon.gg origin, where their ID token lives. Public matchmaking put
    // that one "Find Match" click from any stranger. It was also unbounded:
    // 60,000-char lines and 500-element writes were both accepted, on the same
    // document that takes every score write.
    //
    // So: chat is data now, each line is validated here, and free text is
    // PRIVATE MATCHES ONLY. A public match may only send one of a closed set of
    // phrases, which is why the game needs no profanity filter — a phrase off
    // this list is rejected by the server, not merely absent from the UI.
    // index.html holds the same list in CHAT_PRESETS; tests/chat-safety pins
    // the two together.
    function chatPresets() {
      return ['Good luck!', 'Nice!', 'Wow!', 'So close!', 'gg', 'Thanks!'];
    }

    // Absent or null counts as PUBLIC — the restrictive side — so a malformed
    // match doc cannot unlock free text. index.html's chatMatchIsPublic()
    // defaults identically.
    function matchIsPublic(m) { return m.get('isPublic', true) != false; }

    function validChatLine(line, isPublic) {
      return line is map
        && line.keys().hasOnly(['u', 'n', 't', 'p', 'at'])
        && line.keys().hasAll(['u', 'n', 't', 'p', 'at'])
        // You may only ever speak as yourself. Without this, any participant
        // could post a line attributed to an opponent — "i forfeit, you win"
        // under their name, indistinguishable from the real thing.
        && line.u == request.auth.uid
        && line.n is string && line.n.size() > 0 && line.n.size() <= 20
        && line.n.matches('^[^<>]*$')
        && line.t is string
        && line.p is bool
        && line.at is int
        && (line.p
              ? line.t in chatPresets()
              : (!isPublic && line.t.size() > 0 && line.t.size() <= 50));
    }

    // Exactly one line per write, appended, with the history intact and a hard
    // ceiling on the whole match. That ceiling is the spam bound: rules cannot
    // express a per-player rate limit without per-slot timestamp fields, but a
    // match that can hold 40 lines total and lasts seven minutes at the outside
    // is not a spam surface worth more machinery.
    function validChatAppend(isPublic) {
      return request.resource.data.chat is list
        && request.resource.data.chat.size() == resource.data.chat.size() + 1
        && request.resource.data.chat.size() <= 40
        && request.resource.data.chat.hasAll(resource.data.chat)
        && validChatLine(request.resource.data.chat[resource.data.chat.size()], isPublic);
    }

    function chatUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['chat']);
    }

    // Every gameplay write must either leave chat alone or be one valid
    // appended line. Applied to the 1v1 and FFA update rules alike.
    function chatOk() {
      return chatUntouched() || validChatAppend(matchIsPublic(resource.data));
    }

    // An update may never touch createdAt. Pushing it forward would make a
    // match outlive cleanup indefinitely, which is the whole thing this is
    // meant to stop.
    function createdAtPinned() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt']);
    }

    // Cosmetic ids get rendered straight into class="..." on the leaderboard,
    // live feed, and race cards. `equipped` is the one profile field a client
    // may write directly, and a run doc carries its own copy — so without
    // this, a devtools-savvy player could store markup here and have it
    // rendered in every other player's browser. Every real id is generated by
    // the shop tables and matches ^[a-z0-9_]+$. The client escapes on render
    // too; this is the backstop that keeps the bad value out of the database
    // in the first place. .get(key, default) mirrors matchMode() above — a
    // legacy loadout missing a key stays writable rather than being bricked.
    function validCosmetic(v) {
      return v is string && v.size() > 0 && v.size() <= 40 && v.matches('^[a-z0-9_]+$');
    }
    function validEquipped(e) {
      return e is map
        && e.keys().hasOnly(['title', 'skin', 'banner', 'effect'])
        && validCosmetic(e.get('title', 'title_none'))
        && validCosmetic(e.get('skin', 'skin_default'))
        && validCosmetic(e.get('banner', 'banner_default'))
        && validCosmetic(e.get('effect', 'effect_none'));
    }

    match /users/{userId} {
      // Public profile info (username, cosmetics, mmr, careerBank) is read
      // for the leaderboard, live feed, and rank lookups.
      allow read: if isSignedIn();

      // New accounts must start at the same defaults the app gives every
      // player — no "create my doc pre-loaded with a million points".
      allow create: if isOwner(userId)
        && request.resource.data.wallet == 0
        && request.resource.data.careerBank == 0
        // Clash's rating is minted by onMatchFinished on a player's first
        // public match, so a fresh profile carries no `mmr` at all and is
        // absent from the ladder's index until they have played one — the
        // shape ffaMmr already has. A cached older copy of index.html still
        // sends the old 1000 seed, so that exact value is still accepted
        // (refreshProfile takes it back off on the next sign-in); any OTHER
        // starting rating is not.
        && (!('mmr' in request.resource.data) || request.resource.data.mmr == 1000)
        && request.resource.data.handleChanges == 0
        && request.resource.data.achievedTop10Daily == 0
        // Every field below is written only by a Cloud Function, and none of
        // them was constrained here. `create` is the one write a client makes
        // to its own profile that is not narrowed to `equipped`, so a brand
        // new account could arrive pre-seeded with a bestRunScore no run ever
        // produced and own the All-Time board outright — same for the weekly,
        // daily and FFA ladders. They are absent on create, full stop.
        && !('bestRunScore' in request.resource.data)
        && !('bestRunAt' in request.resource.data)
        && !('periodBestScore' in request.resource.data)
        && !('periodBestKey' in request.resource.data)
        && !('periodBestAt' in request.resource.data)
        && !('dayBestScore' in request.resource.data)
        && !('dayBestKey' in request.resource.data)
        && !('ffaMmr' in request.resource.data)
        && !('ffaWins' in request.resource.data)
        && !('ffaMatchesPlayed' in request.resource.data)
        && request.resource.data.totalWordsGuessed == 0
        && request.resource.data.wordsPlayed == 0
        && request.resource.data.guess1 == 0 && request.resource.data.guess2 == 0
        && request.resource.data.guess3 == 0 && request.resource.data.guess4 == 0
        && request.resource.data.guess5 == 0 && request.resource.data.fails == 0
        && request.resource.data.kobeCount == 0
        && request.resource.data.clashWins == 0 && request.resource.data.clashLosses == 0
        && request.resource.data.clashTies == 0
        // These four directly gate one-time challenge rewards (up to 75k
        // pts) — without forcing them to 0/null here, a throwaway account
        // could self-seed a fake streak and claim rewards it never earned.
        && request.resource.data.loginStreak == 0 && request.resource.data.bestLoginStreak == 0
        && request.resource.data.lastLoginDate == null
        && request.resource.data.currentClashWinStreak == 0 && request.resource.data.bestClashWinStreak == 0
        && request.resource.data.bestNoMissStreak == 0
        && request.resource.data.inventory == ["title_none", "skin_default", "banner_default", "effect_none"]
        && request.resource.data.claimedCareer == []
        && request.resource.data.dailyStats.played == 0
        && request.resource.data.dailyStats.guessed == 0
        && request.resource.data.dailyStats.claimed == [];

      // The ONLY field the client may ever update directly on its own
      // profile is its cosmetic loadout. Wallet, careerBank, mmr, win/loss
      // records, stat counters, inventory, username, claimed lists — all of
      // it goes through a Cloud Function instead.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['equipped'])
        && validEquipped(request.resource.data.equipped);

      allow delete: if false;
    }

    match /runs/{runId} {
      allow read: if isSignedIn();

      // The client reports what happened in a run; the onRunCreated Cloud
      // Function is what turns this into wallet/stat changes on the user
      // doc, after these bounds are enforced. Bounds are deliberately
      // generous (they exist to block "set score to a billion", not to
      // referee gameplay balance).
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 1000000
        && request.resource.data.lostScore is number && request.resource.data.lostScore >= 0 && request.resource.data.lostScore <= 1000000
        && request.resource.data.wordsGuessed is number && request.resource.data.wordsGuessed >= 0 && request.resource.data.wordsGuessed <= 5000
        && request.resource.data.wordsPlayed is number && request.resource.data.wordsPlayed >= 0 && request.resource.data.wordsPlayed <= 5000
        && request.resource.data.guess1 is number && request.resource.data.guess1 >= 0 && request.resource.data.guess1 <= 5000
        && request.resource.data.guess2 is number && request.resource.data.guess2 >= 0 && request.resource.data.guess2 <= 5000
        && request.resource.data.guess3 is number && request.resource.data.guess3 >= 0 && request.resource.data.guess3 <= 5000
        && request.resource.data.guess4 is number && request.resource.data.guess4 >= 0 && request.resource.data.guess4 <= 5000
        && request.resource.data.guess5 is number && request.resource.data.guess5 >= 0 && request.resource.data.guess5 <= 5000
        && request.resource.data.fails is number && request.resource.data.fails >= 0 && request.resource.data.fails <= 5000
        && request.resource.data.kobeCount is number && request.resource.data.kobeCount >= 0 && request.resource.data.kobeCount <= 5000
        && request.resource.data.bestStreak is number && request.resource.data.bestStreak >= 0 && request.resource.data.bestStreak <= 5000
        && request.resource.data.timestamp == request.time
        // Everything above bounds the numbers; these two were the only
        // free-form fields left, and both are rendered as other players'
        // names/cosmetics in the live feed and leaderboard. Angle brackets
        // are all that's needed to inject markup, and no legitimate handle
        // contains one — deliberately permissive otherwise so existing
        // accounts (a Google display name with an accent, say) keep saving.
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 40
        && request.resource.data.username.matches('^[^<>]*$')
        && validEquipped(request.resource.data.equipped)
        // Per-word difficulty samples. Optional on purpose: a browser still
        // running a cached copy of index.html does not send it, and a run is
        // far too important to reject over telemetry. Rules only bound the
        // size — a list of maps can't be inspected element by element here —
        // so aggregateWordStats re-checks every entry against the real target
        // list before counting it.
        && (!('wordLog' in request.resource.data)
            || (request.resource.data.wordLog is list && request.resource.data.wordLog.size() <= 300));

      // payoutApplied is added afterwards by the Cloud Function (Admin SDK,
      // bypasses rules) — the client can never edit a run once created.
      allow update, delete: if false;
    }

    match /matches/{matchId} {
      allow read: if isSignedIn();

      // A new room starts silent. Without this a host could create a match
      // whose chat array already held a payload, side-stepping the per-line
      // validation below entirely (all four client creation sites already
      // send chat: []).
      // createdAt is how a match can be cleaned up later. Pinning it to
      // request.time makes it a SERVER timestamp that the client cannot choose:
      // a client-supplied age could be wrong in the direction that deletes a
      // match still being played, and an immortal match is the other failure.
      // Match docs carried no creation time at all before this, which is why
      // every match ever played was still sitting in Firestore.
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.chat == []
        && request.resource.data.createdAt == request.time;

      // Either participant can update live gameplay fields (scores, mini-
      // boards, chat, endTime) and a guest can claim the open slot (status
      // waiting -> playing), but neither may touch the payout fields, and
      // NEITHER may ever set winner/endReason or move status to 'finished'
      // directly — that decision is Cloud-Function-only now (see
      // finishClashMatch/forfeitClashMatch/onMatchFinished). This used to
      // just deny the three payout fields and leave status/winner wide
      // open — any participant could, at any point mid-match, write
      // themselves in as the winner with a bare updateDoc. 1v1 duels
      // only — mode:'ffa' matches are handled by the block below instead.
      allow update: if isSignedIn() && matchMode(resource.data) != 'ffa'
        && (resource.data.hostUid == request.auth.uid
            || resource.data.guestUid == request.auth.uid
            || (resource.data.guestUid == null && request.resource.data.guestUid == request.auth.uid))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hostChange', 'guestChange', 'payoutApplied', 'winner', 'endReason'])
        && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'waiting' && request.resource.data.status == 'playing'))
        && chatOk() && createdAtPinned();

      // Clash: Free-For-All (3-6 players, see functions/index.js). Unlike
      // the 1v1 rule above, joining/starting/finishing a match ALL go
      // through callables (joinFfaMatch/startFfaMatch/finishFfaMatch) —
      // there's a real race in claiming one of a fixed number of open
      // slots that a plain client updateDoc can't safely resolve, the way
      // 1v1's single guest slot gets away with. So a client here may only
      // ever touch its own live gameplay fields (pNScore/pNWordIndex/
      // pNSkips) and chat — every identity, roster, timing, and payout
      // field is Admin-SDK-only.
      allow update: if isSignedIn() && matchMode(resource.data) == 'ffa'
        && (request.auth.uid == resource.data.p0Uid || request.auth.uid == resource.data.p1Uid
            || request.auth.uid == resource.data.p2Uid || request.auth.uid == resource.data.p3Uid
            || request.auth.uid == resource.data.p4Uid || request.auth.uid == resource.data.p5Uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'mode', 'hostUid', 'isPublic', 'status', 'maxPlayers', 'playerCount',
             'words', 'endTime', 'lobbyDeadline', 'winners', 'changes', 'payoutApplied',
             'leftPlayers',
             'p0Uid', 'p1Uid', 'p2Uid', 'p3Uid', 'p4Uid', 'p5Uid',
             'p0Name', 'p1Name', 'p2Name', 'p3Name', 'p4Name', 'p5Name',
             'p0Equipped', 'p1Equipped', 'p2Equipped', 'p3Equipped', 'p4Equipped', 'p5Equipped',
             'p0Mmr', 'p1Mmr', 'p2Mmr', 'p3Mmr', 'p4Mmr', 'p5Mmr'
           ])
        && chatOk() && createdAtPinned();

      // A 1v1 host may delete their match at any time (mirrors the client's
      // existing leaveVersusMatch behavior). An FFA host may only delete
      // theirs while it's still a lobby — once it's 'playing', up to 3
      // other real players are mid-race in it; deleting the doc would wipe
      // the match for all of them and skip payout entirely, instead of the
      // host's own slot simply going stale like any other abandoned player.
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid
        && (matchMode(resource.data) != 'ffa' || resource.data.status == 'waiting');
    }

    // A finished day's Standard board, snapshotted once by the daily job so
    // the home screen can show past days without re-reading every run of that
    // day. TODAY's board is deliberately not here: it is read live off /users,
    // which is what lets it reorder as people play.
    match /dailyBoards/{date} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Daily Gauntlet's target words — NEVER readable by any client. The
    // client only ever learns them one guess's color feedback at a time via
    // the guessDailyWord Cloud Function; a readable rule here would let
    // anyone open devtools and read the day's answers before playing.
    match /dailyPuzzles/{date} {
      allow read, write: if false;
    }

    // A player's own progress through today's (or a past) gauntlet — safe
    // to let them read directly (past guesses + color feedback + score,
    // never the unsolved target words), but every write goes through
    // startDailyGauntlet/guessDailyWord (Admin SDK), never the client SDK.
    match /dailyAttempts/{userId}/days/{date} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Clash sudden-death's secret word + each side's graded guess for the
    // current round — same reasoning as dailyPuzzles: never client-readable,
    // or a devtools-savvy player could see the word (or their opponent's
    // still-pending guess) before the round resolves. Public, non-spoiling
    // state (round number, deadline, who's submitted, the eventual result)
    // lives on the match doc instead, written by the same Cloud Functions.
    match /matchSecrets/{matchId} {
      allow read, write: if false;
    }
  }
}
